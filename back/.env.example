# 复制成 .env 后按需修改：copy .env.example .env
# .env 已被 .gitignore 忽略，不会被提交。

# ---- 数据库 ----
# 默认 SQLite：本机零配置，clone 下来就能跑。
DATABASE_URL=sqlite:///./shishi.db
# CONTENT_MODE=auto 会自动识别清洗后的六张内容表。
CONTENT_MODE=auto
#
# MySQL 清洗库（密码里有 @、# 等字符时需要 URL 编码）：
# DATABASE_URL=mysql+pymysql://root:password@127.0.0.1:3306/shishi?charset=utf8mb4
# CONTENT_MODE=compact
#
# 切换 PostgreSQL 只改上面这一行（另外要装 psycopg[binary]）：
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/shishi

# ---- 认证（说明书 §12）----
# ⚠️ 换生产环境必须改成随机值，否则任何人都能伪造 token：
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ---- 其他 ----
DEBUG=true
