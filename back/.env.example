# 复制成 .env 后按需修改：copy .env.example .env
# .env 已被 .gitignore 忽略，不会被提交。

# ---- 数据库 ----
# 默认 SQLite：本机零配置，clone 下来就能跑。
DATABASE_URL=sqlite:///./shishi.db
# CONTENT_MODE=auto 会自动识别清洗后的六张内容表。
CONTENT_MODE=auto
#
# MySQL 清洗库（密码里有 @、# 等字符时需要 URL 编码）：
# DATABASE_URL=mysql+pymysql://root:password@127.0.0.1:3306/shishi?charset=utf8mb4
# CONTENT_MODE=compact
#
# 切换 PostgreSQL 只改上面这一行（另外要装 psycopg[binary]）：
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/shishi

# ---- 认证（说明书 §12）----
# ⚠️ 换生产环境必须改成随机值，否则任何人都能伪造 token：
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ---- 其他 ----
DEBUG=true

# =====================================================================
# AI 大模型（DeepSeek / 任何兼容 OpenAI 协议的服务）
# =====================================================================
# 【不配也能跑】
#   AI_API_KEY 留空时，首页推荐和 AI 助手会自动退回确定性算法：
#   候选由综合打分算法从我们自己的库里筛，文案用规则生成，接口结构完全不变。
#
# 【⚠️ 不要把真 key 提交进仓库】
#   .env 已被 .gitignore 忽略。部署到服务器时，请把 key 单独发给运维同学，
#   在那台机器的 back/.env 里填 —— 不要写进任何会被提交的文件。
#
# 换服务商只改 AI_BASE_URL / AI_MODEL，代码一行不用动。
AI_ENABLED=true
AI_BASE_URL=https://api.deepseek.com
AI_API_KEY=
AI_MODEL=deepseek-chat
# 单次调用超时（秒）。超时即降级，不会把首页拖死。
AI_TIMEOUT_SECONDS=45
AI_MAX_TOKENS=1200
AI_TEMPERATURE=0.6
# 首页「每天每地区只问一次 AI」的结果缓存。关掉的话每次请求都会真调模型。
AI_DAILY_CACHE_ENABLED=true
# 交给 AI 挑选的候选数量（算法先筛出这么多，AI 在里面挑最终展示的）
AI_HOME_SHORTLIST=8

# =====================================================================
# 天气（Open-Meteo，免费且不需要 key）
# =====================================================================
# 首页推荐会结合定位城市的实时天气（温度/降水）调整推荐方向。
# 取不到就按月份的时令气候估算，再不行就当「无天气信息」——不会让首页挂掉。
WEATHER_ENABLED=true
WEATHER_BASE_URL=https://api.open-meteo.com/v1/forecast
WEATHER_TIMEOUT_SECONDS=6
